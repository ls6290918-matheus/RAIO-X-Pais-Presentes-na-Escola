# Copie para .env e preencha com os dados do seu projeto Supabase
# (Project Settings > API). Use SOMENTE a chave anon/public aqui.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon
# Google Maps (opcional): chave de navegador restrita ao domínio do site
VITE_GOOGLE_MAPS_API_KEY=
# Notificações push (Firebase Cloud Messaging) — configuração PÚBLICA do app web do Firebase
# (Configurações do projeto > Geral > Seus apps) e a chave VAPID (Cloud Messaging > Web Push).
# A conta de serviço (JSON) NUNCA vai aqui: ela é segredo da Edge Function (FCM_SERVICE_ACCOUNT).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
